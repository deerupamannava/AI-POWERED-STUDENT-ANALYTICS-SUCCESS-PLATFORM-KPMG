# Copy this file to .env. Keep API keys private; never commit .env to GitHub.
SECRET_KEY=replace-this-with-a-long-random-secret
# Optional: add an OpenAI API key to enable AI-generated recommendations.
# Without it, the app uses its built-in personalized study-plan generator.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
FLASK_DEBUG=false
PORT=5000
